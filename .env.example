# Copy to .env (or .env.local) and adjust. Vite only reads VITE_* variables.
# Never commit real .env files: they are git-ignored.

# Optional CORS proxy for feeds that block direct browser requests.
# The string may contain a {url} placeholder that receives the encoded feed URL.
# If {url} is absent, the encoded URL is appended to the end.
# Example: https://your-worker.workers.dev/api/proxy?url={url}
# VITE_CORS_PROXY=

# Disables the built-in same-origin /api/proxy fallback. Set this on static hosts
# without serverless functions, such as GitHub Pages (build:pages sets it for you).
# VITE_DISABLE_LOCAL_PROXY=1

# Public base path of the deployed app. Leave unset for '/' (local dev and root hosting).
# GitHub Pages project sites use the repository name: https://<user>.github.io/OpenHorizon/
# VITE_BASE=/OpenHorizon/
